
<% layout("./layouts/boilerplate") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">

      <div class="card bg-dark text-light border-secondary rounded-4 shadow-lg">
        <div class="card-body p-4 p-md-5">

          <div class="text-center mb-4">
            <i class="fa-solid fa-list-check fa-3x text-primary mb-3"></i>
            <h2 class="fw-bold">Welcome Back</h2>
            <p class="text-secondary">Log in to continue with TAYO</p>
          </div>

          <form action="/login" method="POST">
            <div class="mb-3">
              <label for="username" class="form-label">Username</label>
              <input
                type="text"
                id="username"
                name="username"
                class="form-control"
                placeholder="Enter your username"
                autocomplete="username"
                required
              >
            </div>

            <div class="mb-4">
              <label for="password" class="form-label">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                class="form-control"
                placeholder="Enter your password"
                autocomplete="current-password"
                required
              >
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-pill">
              <i class="fa-solid fa-right-to-bracket me-2"></i>
              Log In
            </button>
          </form>

          <p class="text-center text-secondary mt-4 mb-0">
            Don't have an account?
            <a href="/signup" class="text-decoration-none">Sign Up</a>
          </p>

        </div>
      </div>

    </div>
  </div>
</div>