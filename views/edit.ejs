<% layout("./layouts/boilerplate") %>
    </head>

    <body>
        <div class="row">

            <div class="col-4 offset-4">
                <br>
                <h3>Edit Todo's name</h3>
                <hr>
                <form action="/todos/<%= todo._id %>?_method=PUT" method="post">

                    <div>
                        <label class="form-label">Enter new name</label>
                        <textarea class="form-control" name="title" rows="3" cols="5"><%= todo.title %></textarea>
                    </div>
                    <br>
                    <button type="submit" class="btn btn-success">edit</button>
                </form>
                <hr>
            </div>

        </div>
    </body>