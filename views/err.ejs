<% layout("./layouts/boilerplate") %>

<div class="container min-vh-75 d-flex align-items-center justify-content-center py-5">
  <div class="card bg-dark text-light border-secondary rounded-4 shadow-lg text-center p-4 p-md-5 w-100"
       style="max-width: 550px;">

    <i class="fa-solid fa-circle-exclamation text-danger fa-4x mb-4"></i>

    <h1 class="display-3 fw-bold text-danger">
      <%= statusCode %>
    </h1>

    <h4 class="fw-semibold mb-3">Oops! Something went wrong.</h4>

    <div class="alert alert-danger rounded-3" role="alert">
      <%= message %>
    </div>

    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 mt-3">
      <button onclick="history.back()" class="btn btn-outline-light rounded-pill px-4">
        <i class="fa-solid fa-arrow-left me-2"></i>Go Back
      </button>

      <a href="/todos" class="btn btn-primary rounded-pill px-4">
        <i class="fa-solid fa-house me-2"></i>Back to Todos
      </a>
    </div>

  </div>
</div>