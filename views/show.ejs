<% layout("./layouts/boilerplate") %>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-7">

                <!-- New Task Button -->
                <div class="d-flex justify-content-end mb-4">
                    <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal"
                        data-bs-target="#newTaskModal">
                        <i class="fa-solid fa-plus me-2"></i>New Task
                    </button>
                </div>

                <!-- New Task Modal -->
                <div class="modal fade" id="newTaskModal" tabindex="-1" aria-labelledby="newTaskModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-light border-secondary rounded-4">

                            <div class="modal-header border-secondary">
                                <h5 class="modal-title fw-bold" id="newTaskModalLabel">
                                    <i class="fa-solid fa-pen-to-square text-primary me-2"></i>
                                    Add a New Task
                                </h5>

                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>

                            <form action="/todos/<%= todo._id %>/tasks" method="post">

                                <div class="modal-body p-4">
                                    <label for="newTaskInput" class="form-label">
                                        Task name
                                    </label>

                                    <input type="text" name="task" id="newTaskInput"
                                        class="form-control form-control-lg" placeholder="What needs to be done?"
                                        required>
                                </div>

                                <div class="modal-footer border-secondary">
                                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">
                                        Cancel
                                    </button>

                                    <button type="submit" class="btn btn-primary px-4">
                                        <i class="fa-solid fa-plus me-2"></i>Add Task
                                    </button>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>

                <!-- Todo Heading -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                    <h2 class="fw-bold mb-0 text-break">
                        <i class="fa-solid fa-list-check text-primary me-2"></i>
                        <%= todo.title %>
                    </h2>

                    <span class="badge rounded-pill text-bg-primary fs-6">
                        <%= todo.tasks.length %> tasks
                    </span>
                </div>

                <!-- Tasks List -->
                <div class="card bg-dark text-light border-secondary rounded-4 overflow-hidden">

                    <div
                        class="card-header border-secondary d-flex justify-content-between align-items-center py-3 px-4">
                        <h5 class="mb-0">My Tasks</h5>
                        <i class="fa-solid fa-list text-primary"></i>
                    </div>

                    <ul class="list-group list-group-flush">

                        <% for (let task of todo.tasks) { %>
                            <li
                                class="list-group-item bg-dark text-light border-secondary d-flex align-items-center justify-content-between gap-3 px-4 py-3">

                                <span class="text-break">
                                        <form action="/todos/<%= todo._id %>/tasks/<%= task._id %>" method="post" style="display: inline;">
                                            <input type="checkbox" id="checkinverse" name="checked" class="check theme-inverse" value="true" onchange="this.form.submit()" <%= task.checked ? "checked" : "" %> />
                                        </form>
                                    &nbsp;&nbsp;<%= task.tasks %>
                                </span>


                                <button type="button" class="btn btn-outline-danger  btn-sm" data-bs-toggle="modal"
                                    data-bs-target="#deleteTaskModal<%= task._id %>">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>

                                <!--* Modal for delete popup -->
                                <div class="modal fade" id="deleteTaskModal<%= task._id %>" tabindex="-1"
                                    aria-labelledby="deleteTaskModalLabel<%= task._id %>" aria-hidden="true">

                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content bg-dark text-light border-secondary rounded-4">

                                            <div class="modal-header border-secondary">
                                                <h5 class="modal-title" id="deleteTaskModalLabel<%= task._id %>">
                                                    <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                                                    Delete Task
                                                </h5>

                                                <button type="button" class="btn-close btn-close-white"
                                                    data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <div class="modal-body text-secondary">
                                                Are you sure you want to delete this task?
                                                This action cannot be undone.
                                            </div>

                                            <div class="modal-footer border-secondary">
                                                <button type="button" class="btn btn-outline-light"
                                                    data-bs-dismiss="modal">
                                                    Cancel
                                                </button>

                                                <form
                                                    action="/todos/<%= todo._id %>/tasks/<%= task._id %>?_method=DELETE"
                                                    method="post">
                                                    <button type="submit" class="btn btn-danger">
                                                        <i class="fa-solid fa-trash-can me-2"></i>
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <!-- <form
                                action="/todos/<%= todo._id %>/tasks/<%= task._id %>?_method=DELETE"
                                method="post"
                                onsubmit="return confirm('Delete this task?')"
                            >
                                <button
                                    type="submit"
                                    class="btn btn-outline-danger btn-sm"
                                    aria-label="Delete task"
                                    title="Delete task"
                                >
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form> -->

                            </li>
                            <% } %>

                                <% if (todo.tasks.length===0) { %>
                                    <li class="list-group-item bg-dark text-secondary text-center py-5">
                                        <i class="fa-regular fa-clipboard fa-2x mb-3"></i>
                                        <p class="mb-1">No tasks yet</p>
                                        <small>Click "New Task" to get started!</small>
                                    </li>
                                    <% } %>

                    </ul>
                </div>

            </div>
        </div>
    </div>