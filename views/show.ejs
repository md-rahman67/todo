
<% layout("./layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-8">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <a href="/todos" class="btn btn-outline-light rounded-pill">
                    <i class="fa-solid fa-arrow-left me-2"></i>Todos
                </a>

                <button class="btn btn-primary rounded-pill px-4"
                    data-bs-toggle="modal" data-bs-target="#newTaskModal">
                    <i class="fa-solid fa-plus me-2"></i>Add Task
                </button>
            </div>

            <!-- Todo Details -->
            <div class="card bg-dark text-light border-secondary rounded-4 mb-4">
                <div class="card-body p-4 p-md-5">

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-primary bg-opacity-25 rounded-3 p-3">
                            <i class="fa-solid fa-list-check fa-xl text-primary"></i>
                        </div>

                        <div class="flex-grow-1">
                            <p class="text-secondary small mb-1">MY TODO LIST</p>
                            <h2 class="fw-bold mb-0 text-break"><%= todo.title %></h2>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
                        <span class="text-secondary small">
                            <i class="fa-solid fa-user me-2"></i>
                            <%= todo.createdBy.username %>
                        </span>

                        <span class="badge rounded-pill text-bg-primary px-3 py-2">
                            <%= todo.tasks.length %> Tasks
                        </span>
                    </div>

                </div>
            </div>

            <!-- Task List -->
            <div class="card bg-dark text-light border-secondary rounded-4 overflow-hidden">

                <div class="card-header border-secondary px-4 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold">Your Tasks</h5>
                    <i class="fa-solid fa-list-ul text-secondary"></i>
                </div>

                <ul class="list-group list-group-flush">

                    <% for (let task of todo.tasks) { %>
                        <li class="list-group-item bg-dark text-light border-secondary px-4 py-3">
                            <div class="d-flex align-items-center gap-3">

                                <!-- Checkbox -->
                                <form action="/todos/<%= todo._id %>/tasks/<%= task._id %>"
                                    method="post" class="d-flex align-items-center">
                                    <input
                                        type="checkbox"
                                        id="check-<%= task._id %>"
                                        name="checked"
                                        value="true"
                                        class="form-check-input mt-0"
                                        onchange="this.form.submit()"
                                        aria-label="Mark task as completed"
                                        <%= task.checked ? "checked" : "" %>
                                    >
                                </form>

                                <!-- Task Name -->
                                <label for="check-<%= task._id %>"
                                    class="flex-grow-1 mb-0 text-break <%= task.checked ? 'text-decoration-line-through text-secondary' : '' %>">
                                    <%= task.tasks %>
                                </label>

                                <!-- Delete Button -->
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-circle"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteTaskModal<%= task._id %>"
                                    aria-label="Delete task">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>

                            </div>
                        </li>

                        <!-- Delete Confirmation Modal -->
                        <div class="modal fade" id="deleteTaskModal<%= task._id %>"
                            tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content bg-dark text-light border-secondary rounded-4">

                                    <div class="modal-header border-secondary">
                                        <h5 class="modal-title fw-bold">
                                            <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                                            Delete Task?
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white"
                                            data-bs-dismiss="modal"></button>
                                    </div>

                                    <div class="modal-body text-secondary">
                                        Are you sure you want to delete
                                        "<%= task.tasks %>"?
                                        This action cannot be undone.
                                    </div>

                                    <div class="modal-footer border-secondary">
                                        <button type="button" class="btn btn-outline-light rounded-pill"
                                            data-bs-dismiss="modal">
                                            Cancel
                                        </button>

                                        <form action="/todos/<%= todo._id %>/tasks/<%= task._id %>?_method=DELETE"
                                            method="post">
                                            <button type="submit" class="btn btn-danger rounded-pill">
                                                <i class="fa-solid fa-trash-can me-2"></i>Delete
                                            </button>
                                        </form>
                                    </div>

                                </div>
                            </div>
                        </div>
                    <% } %>

                    <!-- Empty State -->
                    <% if (todo.tasks.length === 0) { %>
                        <li class="list-group-item bg-dark text-center text-secondary py-5">
                            <i class="fa-solid fa-clipboard-list fa-3x mb-3"></i>
                            <h5 class="text-light">Nothing here yet</h5>
                            <p class="mb-3">Add your first task and get things moving.</p>
                            <button class="btn btn-primary rounded-pill px-4"
                                data-bs-toggle="modal" data-bs-target="#newTaskModal">
                                <i class="fa-solid fa-plus me-2"></i>Create First Task
                            </button>
                        </li>
                    <% } %>

                </ul>

                <div class="card-footer bg-dark border-secondary text-secondary small px-4 py-3">
                    <i class="fa-solid fa-circle-check me-2"></i>
                    Stay focused, one task at a time.
                </div>

            </div>

        </div>
    </div>
</div>

<!-- Add Task Modal -->
<div class="modal fade" id="newTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary rounded-4">

            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-pen-to-square text-primary me-2"></i>
                    Add a New Task
                </h5>
                <button type="button" class="btn-close btn-close-white"
                    data-bs-dismiss="modal"></button>
            </div>

            <form action="/todos/<%= todo._id %>/tasks" method="post">
                <div class="modal-body p-4">
                    <label for="newTaskInput" class="form-label">Task name</label>
                    <input type="text" name="task" id="newTaskInput"
                        class="form-control form-control-lg"
                        placeholder="What needs to be done?"
                        maxlength="200" required>
                </div>

                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-light rounded-pill"
                        data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="fa-solid fa-plus me-2"></i>Add Task
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>