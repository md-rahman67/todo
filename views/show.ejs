
<% layout("./layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-7">

            <!-- Add Task Form -->
            <div class="card bg-dark text-light border-secondary rounded-4 mb-5">
                <div class="card-body p-4">
                    <h5 class="mb-4">
                        <i class="fa-solid fa-pen-to-square text-primary me-2"></i>
                        Enter Task
                    </h5>

                    <form action="/todos/<%= todo._id %>/tasks" method="post">
                        <div class="mb-3">
                            <input
                                type="text"
                                name="task"
                                id="task"
                                class="form-control form-control-lg"
                                placeholder="Add a task..."
                                required
                            >
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fa-solid fa-plus me-2"></i>
                            Add Task
                        </button>
                    </form>
                </div>
            </div>

            <!-- Todo Heading -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                <h2 class="fw-bold mb-0 text-break">
                    <i class="fa-solid fa-list-check text-primary me-2"></i>
                    <%= todo.title %>
                </h2>

                <span class="badge rounded-pill text-bg-primary fs-6">
                    <%= todo.tasks.length %> tasks
                </span>
            </div>

            <!-- Tasks List -->
            <div class="card bg-dark text-light border-secondary rounded-4 overflow-hidden">

                <div class="card-header border-secondary d-flex justify-content-between align-items-center py-3 px-4">
                    <h5 class="mb-0">My Tasks</h5>
                    <i class="fa-solid fa-list text-primary"></i>
                </div>

                <ul class="list-group list-group-flush">

                    <% for (let task of todo.tasks) { %>
                        <li class="list-group-item bg-dark text-light border-secondary d-flex align-items-center justify-content-between gap-3 px-4 py-3">

                            <span class="text-break">
                                <i class="fa-regular fa-circle text-secondary me-3"></i>
                                <%= task.tasks %>
                            </span>

                            <form
                                action="/todos/<%= todo._id %>/tasks/<%= task._id %>?_method=DELETE"
                                method="post"
                                onsubmit="return confirm('Delete this task?')"
                            >
                                <button
                                    type="submit"
                                    class="btn btn-outline-danger btn-sm"
                                    aria-label="Delete task"
                                    title="Delete task"
                                >
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>

                        </li>
                    <% } %>

                    <% if (todo.tasks.length === 0) { %>
                        <li class="list-group-item bg-dark text-secondary text-center py-5">
                            <i class="fa-regular fa-clipboard fa-2x mb-3"></i>
                            <p class="mb-1">No tasks yet</p>
                            <small>Add your first task above!</small>
                        </li>
                    <% } %>

                </ul>
            </div>

        </div>
    </div>
</div>
