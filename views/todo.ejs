<% layout("./layouts/boilerplate") %>

    <body>
        <!-- <a href="/listings/new">New Listing</a> -->
        <h3>All Todos</h3>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% for (todo of todos) { %>
                <div class="col">
                    <div class="card h-100" style="width: 100%; height: auto;">
                        <a href="/todos/<%= todo._id %>">
                            <img src="https://i.pinimg.com/1200x/18/d2/d1/18d2d1777738a20aa5c38a681e973388.jpg"
                                class="card-img-top" alt="...">
                        </a>
                        <div class="card-body">
                            <h4 class="card-title">
                                <%= todo.title %>
                            </h4>
                            <span>
                                <a href="/todos/<%= todo._id %>/edit" class="btn btn-primary">Edit</a>
                                 &nbsp;&nbsp;&nbsp;&nbsp;
                                <form action="/todos/<%= todo._id %>?_method=DELETE" method="post" style="display: inline;">
                                    <button class="btn btn-danger">Delete</button>
                                </form>
                            </span>
                        </div>
                    </div>
                </div>
                <% } %>
        </div>


    </body>