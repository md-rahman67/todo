<% layout("./layouts/boilerplate") %>

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-5">
        <div>
            <p class="text-primary fw-semibold small text-uppercase mb-2">
                <i class="fa-solid fa-layer-group me-2"></i>Your Workspace
            </p>
            <h1 class="fw-bold text-light mb-2">My Todos</h1>
            <p class="text-secondary mb-0">
                Organize your day, one task at a time.
            </p>
        </div>

        <button type="button" class="btn btn-primary rounded-pill px-4 py-2"
            data-bs-toggle="modal" data-bs-target="#newTodoModal">
            <i class="fa-solid fa-plus me-2"></i>New Todo
        </button>
    </div>

    <!-- New Todo Modal -->
    <div class="modal fade" id="newTodoModal" tabindex="-1"
        aria-labelledby="newTodoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-light border-secondary rounded-4">

                <div class="modal-header border-secondary">
                    <h5 class="modal-title fw-bold" id="newTodoModalLabel">
                        <i class="fa-solid fa-pen-to-square text-primary me-2"></i>
                        Create a Todo
                    </h5>
                    <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form action="/todos" method="post">
                    <div class="modal-body p-4">
                        <label for="newTodoInput" class="form-label">Todo name</label>
                        <input type="text" name="title" id="newTodoInput"
                            class="form-control form-control-lg"
                            placeholder="e.g. Daily goals" required>
                    </div>

                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline-light rounded-pill"
                            data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                            <i class="fa-solid fa-plus me-2"></i>Create Todo
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <!-- Todo Count -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="text-light fw-semibold mb-0">Your Lists</h5>
        <span class="badge rounded-pill text-bg-secondary px-3 py-2">
            <%= todos.length %> lists
        </span>
    </div>

    <!-- Todo Cards -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        <% for (let todo of todos) { %>
            <div class="col">
                <div class="card h-100 bg-dark text-light border-secondary rounded-4 shadow-sm">

                    <!-- Card Header -->
                    <div class="card-body p-4 d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                            <div class="bg-primary bg-opacity-25 rounded-3 p-3">
                                <i class="fa-solid fa-list-check fa-xl text-primary"></i>
                            </div>

                            <span class="badge rounded-pill text-bg-secondary">
                                <%= todo.tasks.length %> tasks
                            </span>
                        </div>

                        <h4 class="card-title fw-bold text-break mb-2">
                            <%= todo.title %>
                        </h4>

                        <p class="text-secondary small mb-4">
                            <i class="fa-regular fa-clipboard me-2"></i>
                            Keep track of what needs to get done.
                        </p>

                        <a href="/todos/<%= todo._id %>"
                            class="btn btn-outline-primary rounded-pill w-100 mb-4">
                            View Tasks <i class="fa-solid fa-arrow-right ms-2"></i>
                        </a>

                        <div class="d-flex gap-2 mt-auto">

                            <!-- Edit Button -->
                            <button type="button"
                                class="btn btn-outline-light rounded-pill flex-grow-1"
                                data-bs-toggle="modal"
                                data-bs-target="#editTodoModal<%= todo._id %>">
                                <i class="fa-solid fa-pen me-1"></i>Edit
                            </button>

                            <!-- Edit Modal -->
                            <div class="modal fade" id="editTodoModal<%= todo._id %>"
                                tabindex="-1"
                                aria-labelledby="editTodoModalLabel<%= todo._id %>"
                                aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content bg-dark text-light border-secondary rounded-4">

                                        <div class="modal-header border-secondary">
                                            <h5 class="modal-title fw-bold"
                                                id="editTodoModalLabel<%= todo._id %>">
                                                <i class="fa-solid fa-pen-to-square text-primary me-2"></i>
                                                Edit Todo
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white"
                                                data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>

                                        <form action="/todos/<%= todo._id %>?_method=PUT" method="post">
                                            <div class="modal-body p-4">
                                                <label for="editTodoInput<%= todo._id %>"
                                                    class="form-label">Todo name</label>
                                                <input type="text" name="title"
                                                    id="editTodoInput<%= todo._id %>"
                                                    class="form-control form-control-lg"
                                                    value="<%= todo.title %>" required>
                                            </div>

                                            <div class="modal-footer border-secondary">
                                                <button type="button"
                                                    class="btn btn-outline-light rounded-pill"
                                                    data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit"
                                                    class="btn btn-primary rounded-pill px-4">
                                                    Save Changes
                                                </button>
                                            </div>
                                        </form>

                                    </div>
                                </div>
                            </div>

                            <!-- Delete Button -->
                            <button type="button"
                                class="btn btn-outline-danger rounded-pill flex-grow-1"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteTodoModal<%= todo._id %>">
                                <i class="fa-solid fa-trash-can me-1"></i>Delete
                            </button>

                            <!-- Delete Modal -->
                            <div class="modal fade" id="deleteTodoModal<%= todo._id %>"
                                tabindex="-1"
                                aria-labelledby="deleteTodoModalLabel<%= todo._id %>"
                                aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content bg-dark text-light border-secondary rounded-4">

                                        <div class="modal-header border-secondary">
                                            <h5 class="modal-title fw-bold"
                                                id="deleteTodoModalLabel<%= todo._id %>">
                                                <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                                                Delete Todo?
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white"
                                                data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>

                                        <div class="modal-body text-secondary">
                                            Are you sure you want to delete
                                            "<span class="text-light"><%= todo.title %></span>"?
                                            This action cannot be undone.
                                        </div>

                                        <div class="modal-footer border-secondary">
                                            <button type="button"
                                                class="btn btn-outline-light rounded-pill"
                                                data-bs-dismiss="modal">Cancel</button>

                                            <form action="/todos/<%= todo._id %>?_method=DELETE"
                                                method="post">
                                                <button type="submit"
                                                    class="btn btn-danger rounded-pill">
                                                    <i class="fa-solid fa-trash-can me-2"></i>Delete
                                                </button>
                                            </form>
                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        <% } %>

    </div>

    <!-- Empty State -->
    <% if (todos.length === 0) { %>
        <div class="card bg-dark text-light border-secondary rounded-4 text-center py-5 mt-3">
            <div class="card-body p-4">
                <i class="fa-solid fa-clipboard-list fa-3x text-secondary mb-4"></i>
                <h4 class="fw-bold mb-2">Your workspace is empty</h4>
                <p class="text-secondary mb-4">
                    Create your first Todo list and start organizing your day.
                </p>
                <button type="button" class="btn btn-primary rounded-pill px-4"
                    data-bs-toggle="modal" data-bs-target="#newTodoModal">
                    <i class="fa-solid fa-plus me-2"></i>Create Your First Todo
                </button>
            </div>
        </div>
    <% } %>

    <!-- Footer -->
    <p class="text-center text-secondary small mt-5 mb-0">
        <i class="fa-solid fa-check-circle me-2"></i>
        Small steps make big progress.
    </p>

</div>